generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model laboratories {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  slug              String   @unique
  email             String?
  phone             String?
  address           String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime?
  
  // Synchronization fields
  sync_status       String   @default("synced") // synced, pending, conflict, error
  sync_version      Int      @default(1)
  last_synced_at    DateTime?
  is_local_only     Boolean  @default(false) // For offline data

  settings          settings[]
  users             users[]
  patients          patients[]
  patient_contacts  patient_contacts[]
  practitioners     practitioners[]
  visits            visits[]
  orders            orders[]
  order_items       order_items[]
  test_catalog      test_catalog[]
  specimens         specimens[]
  results           results[]
  invoices          invoices[]
  invoice_items     invoice_items[]
  payments          payments[]
  receipts          receipts[]
  products          products[]
  stock_lots        stock_lots[]
  stock_movements   stock_movements[]
  audit_logs        audit_logs[]
  devices           devices[]
  sessions          sessions[]
  sync_events       sync_events[]
  user_roles user_roles[]
  idempotency_keys  idempotency_keys[]
  matricule_counters matricule_counters[] @relation("MatriculeCounterLab")

  @@index([code])
  @@index([slug])
  @@index([is_active])
  @@index([deleted_at])
}

model settings {
  id            String  @id @default(uuid()) 
  laboratory_id String  
  key           String
  value         Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)

  @@unique([laboratory_id, key])
  @@index([laboratory_id])
}

model roles {
  id          String   @id @default(uuid()) 
  code        String   @unique
  name        String
  description String?
  is_system   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_roles user_roles[]

  @@index([code])
  @@index([is_system])
}

model permissions {
  id          String   @id @default(uuid()) 
  code        String   @unique
  name        String
  module      String
  action      String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([code])
  @@index([module])
  @@index([action])
}

model user_roles {
  id          String   @id @default(uuid()) 
  user_id     String   
  role_id     String   
  laboratory_id String 
  assigned_by String?  
  created_at  DateTime @default(now())

  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role     roles     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  assigner users?    @relation("UserRolesAssigner", fields: [assigned_by], references: [id])

  @@unique([user_id, role_id, laboratory_id])
  @@index([user_id])
  @@index([role_id])
  @@index([laboratory_id])
}

model users {
  id             String   @id @default(uuid())
  laboratory_id  String
  email          String
  password_hash  String
  first_name     String
  last_name      String
  phone          String?
  is_active      Boolean  @default(true)
  email_verified Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  deleted_at     DateTime?
  
  // Synchronization fields
  sync_status       String   @default("synced") // synced, pending, conflict, error
  sync_version      Int      @default(1)
  last_synced_at    DateTime?
  is_local_only     Boolean  @default(false) // For offline data

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  user_roles   user_roles[]
  visits       visits[] @relation("VisitCreator")
  orders       orders[] @relation("OrderCreator")
  specimens    specimens[] @relation("SpecimenCollector")
  performed_results results[] @relation("ResultPerformedBy")
  validated_results results[] @relation("ResultValidatedBy")
  sessions     sessions[] @relation("SessionUser")
  audit_logs   audit_logs[] @relation("AuditLogUser")
  session_devices devices[] @relation("SessionUser")
  idempotency_keys idempotency_keys[] @relation("IdempotencyKeyUser")
  stock_movements stock_movements[] @relation("StockMovementCreator")
  assigner_user_roles user_roles[] @relation("UserRolesAssigner")

  @@unique([laboratory_id, email])
  @@index([laboratory_id])
  @@index([email])
  @@index([deleted_at])
}

model patients {
  id            String   @id @default(uuid())
  laboratory_id String
  matricule     String
  first_name    String
  last_name     String
  birth_date    DateTime?
  gender        String   @default("UNKNOWN")
  phone         String?
  email         String?
  address       String?
  ssn           String?
  is_active     Boolean  @default(true)
  deleted_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Synchronization fields
  sync_status       String   @default("synced") // synced, pending, conflict, error
  sync_version      Int      @default(1)
  last_synced_at    DateTime?
  is_local_only     Boolean  @default(false) // For offline data

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  patient_contacts patient_contacts[]
  visits         visits[]
  orders         orders[]
  specimens      specimens[] @relation("LabSpecimens")
  invoice_patients invoices[] @relation("InvoicePatient")

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([matricule])
  @@index([gender])
  @@index([deleted_at])

}

model patient_contacts {
  id            String   @id @default(uuid()) 
  patient_id    String   
  laboratory_id String   
  first_name    String
  last_name     String
  relationship  String
  phone         String
  email         String?
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  patient     patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([laboratory_id])
  @@index([is_primary])
}

model practitioners {
  id             String   @id @default(uuid()) 
  laboratory_id  String   
  matricule      String
  first_name     String
  last_name      String
  specialty      String?
  phone          String?
  email          String?
  license_number String?
  is_active      Boolean  @default(true)
  deleted_at     DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  visits       visits[] @relation("VisitPractitioner")
  orders       orders[] @relation("OrderPractitioner")

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([matricule])
  @@index([deleted_at])
}

model visits {
  id              String   @id @default(uuid()) 
  laboratory_id   String   
  matricule       String
  patient_id      String   
  created_by_id   String   
  practitioner_id String?  
  visit_date      DateTime @default(now())
  status          String   @default("scheduled")
  reason          String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  patient    patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
    creator    users      @relation("VisitCreator", fields: [created_by_id], references: [id])
    practitioner practitioners? @relation("VisitPractitioner", fields: [practitioner_id], references: [id])

  orders orders[]
  specimens specimens[] @relation("VisitSpecimens")
  invoice_visits invoices[] @relation("InvoiceVisit")

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([patient_id])
  @@index([created_by_id])
  @@index([practitioner_id])
  @@index([status])
  @@index([visit_date])

}

model orders {
  id              String   @id @default(uuid()) 
  laboratory_id   String   
  matricule       String
  visit_id        String?  
  patient_id      String   
  practitioner_id String?  
  created_by_id   String   
  order_date      DateTime @default(now())
  status          String   @default("draft")
  priority        String   @default("normal")
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  visit      visits?      @relation(fields: [visit_id], references: [id])
  patient    patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
    practitioner practitioners? @relation("OrderPractitioner", fields: [practitioner_id], references: [id])
    creator    users      @relation("OrderCreator", fields: [created_by_id], references: [id])

  order_items order_items[]
  invoices    invoices[] @relation("OrderInvoices")
  specimen_orders specimens[] @relation("OrderSpecimen")

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([visit_id])
  @@index([patient_id])
  @@index([practitioner_id])
  @@index([created_by_id])
  @@index([status])
  @@index([order_date])

}

model order_items {
  id             String   @id @default(uuid()) 
  order_id       String   
  laboratory_id  String   
  test_catalog_id String  
  item_code      String?
  item_name      String
  status         String   @default("pending")
  result_value   String?
  result_unit    String?
  reference_range String?
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  order         orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  laboratory   laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  test_catalog  test_catalog @relation(fields: [test_catalog_id], references: [id], onDelete: Cascade)

  results results[] @relation("OrderItemResults")

  @@index([order_id])
  @@index([laboratory_id])
  @@index([test_catalog_id])
  @@index([status])

}

model test_catalog {
  id              String   @id @default(uuid()) 
  laboratory_id   String   
  code            String
  name            String
  category        String?
  unit            String?
  reference_range String?
  price           Decimal?
  duration_minutes Int?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  order_items   order_items[]

  invoice_item_test_catalog invoice_items[] @relation("InvoiceItemTestCatalog")
  result_orders results[] @relation("ResultOrderItem")

  @@unique([laboratory_id, code])
  @@index([laboratory_id])
  @@index([code])
  @@index([is_active])
}

model specimens {
  id               String   @id @default(uuid()) 
  laboratory_id    String   
  matricule        String
  order_id         String?  
  visit_id         String?  
  patient_id       String   
  collected_by_id  String   
  collection_date  DateTime @default(now())
  type             String
  container        String?
  status           String   @default("received")
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  order      orders?      @relation("OrderSpecimen", fields: [order_id], references: [id])
  visit      visits?      @relation("VisitSpecimens", fields: [visit_id], references: [id])
  patient    patients     @relation("LabSpecimens", fields: [patient_id], references: [id], onDelete: Cascade)
    collector    users      @relation("SpecimenCollector", fields: [collected_by_id], references: [id])

  results results[] @relation("SpecimenResults")

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([order_id])
  @@index([visit_id])
  @@index([patient_id])
  @@index([collected_by_id])
  @@index([status])
  @@index([collection_date])

}

model results {
  id               String   @id @default(uuid()) 
  laboratory_id    String   
  matricule        String
  specimen_id      String   
  order_item_id    String?  
  test_catalog_id  String   
  performed_by_id  String?  
  validated_by_id  String?  
  value            String?
  unit             String?
  reference_range  String?
  status           String   @default("preliminary")
  version          Int      @default(1)
  validated_at     DateTime?
  deleted_at       DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  specimen   specimens   @relation("SpecimenResults", fields: [specimen_id], references: [id], onDelete: Cascade)
  order_item order_items?     @relation("OrderItemResults", fields: [order_item_id], references: [id])
  test_catalog test_catalog @relation("ResultOrderItem", fields: [test_catalog_id], references: [id], onDelete: Cascade)
  performed_by users?    @relation("ResultPerformedBy", fields: [performed_by_id], references: [id])
  validated_by users?    @relation("ResultValidatedBy", fields: [validated_by_id], references: [id])

  @@unique([laboratory_id, matricule])
  @@index([laboratory_id])
  @@index([specimen_id])
  @@index([order_item_id])
  @@index([test_catalog_id])
  @@index([performed_by_id])
  @@index([validated_by_id])
  @@index([status])
  @@index([deleted_at])

}

model invoices {
  id              String   @id @default(uuid()) 
  laboratory_id   String   
  invoice_number  String
  visit_id        String?  
  order_id        String?  
  patient_id      String   
  issued_date     DateTime @default(now())
  due_date        DateTime?
  status          String   @default("draft")
  subtotal        Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  currency        String   @default("EUR")
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  visit       visits?   @relation("InvoiceVisit", fields: [visit_id], references: [id])
  order       orders?   @relation("OrderInvoices", fields: [order_id], references: [id])
  patient     patients  @relation("InvoicePatient", fields: [patient_id], references: [id], onDelete: Cascade)

  invoice_items invoice_items[]
  payments      payments[]

  @@unique([laboratory_id, invoice_number])
  @@index([laboratory_id])
  @@index([visit_id])
  @@index([order_id])
  @@index([patient_id])
  @@index([status])

}

model invoice_items {
  id             String   @id @default(uuid()) 
  invoice_id     String   
  laboratory_id  String   
  test_catalog_id String? 
  description    String
  quantity       Int      @default(1)
  unit_price     Decimal  @default(0)
  total_price    Decimal  @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  invoice    invoices     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  test_catalog test_catalog? @relation("InvoiceItemTestCatalog", fields: [test_catalog_id], references: [id])

  @@index([invoice_id])
  @@index([laboratory_id])
  @@index([test_catalog_id])
}

model payments {
  id               String   @id @default(uuid()) 
  laboratory_id    String   
  invoice_id       String?  
  idempotency_key  String   @unique
  amount           Decimal
  currency         String   @default("EUR")
  method           String
  status           String   @default("pending")
  paid_at          DateTime?
  reference        String?
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  invoice    invoices?    @relation(fields: [invoice_id], references: [id])

  receipts receipts[]

  @@index([laboratory_id])
  @@index([invoice_id])
  @@index([idempotency_key])
  @@index([status])
  @@index([paid_at])

}

model receipts {
  id            String   @id @default(uuid()) 
  laboratory_id String   
  payment_id    String    @unique
  receipt_number String
  issued_at     DateTime @default(now())
  amount        Decimal
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  payment    payments   @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@unique([laboratory_id, receipt_number])
  @@index([laboratory_id])
  @@index([payment_id])
  @@index([receipt_number])
}

model products {
  id            String   @id @default(uuid()) 
  laboratory_id String   
  sku           String
  name          String
  category      String?
  unit          String?
  current_stock Int      @default(0)
  min_stock     Int      @default(0)
  price         Decimal?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  stock_lots   stock_lots[]
  stock_movements stock_movements[]

  @@unique([laboratory_id, sku])
  @@index([laboratory_id])
  @@index([sku])
  @@index([is_active])
}

model stock_lots {
  id            String   @id @default(uuid()) 
  laboratory_id String   
  product_id    String   
  batch_number  String
  quantity      Int
  expiry_date   DateTime?
  received_date DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  product      products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  stock_movements stock_movements[]

  @@unique([laboratory_id, batch_number])
  @@index([laboratory_id])
  @@index([product_id])
  @@index([batch_number])
}

model stock_movements {
  id             String   @id @default(uuid()) 
  laboratory_id  String   
  product_id     String   
  stock_lot_id   String?  
  movement_type  String
  quantity       Int
  reference      String?
  notes          String?
  created_by_id  String   
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  product      products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  stock_lot    stock_lots? @relation(fields: [stock_lot_id], references: [id])
    creator    users      @relation("StockMovementCreator", fields: [created_by_id], references: [id])

  @@index([laboratory_id])
  @@index([product_id])
  @@index([stock_lot_id])
  @@index([created_by_id])
  @@index([movement_type])
  @@index([created_at])

}

model audit_logs {
  id           String   @id @default(uuid()) 
  laboratory_id String? 
  user_id      String?  
  action       String
  entity       String
  entity_id    String?  
  old_values   Json?
  new_values   Json?
  ip_address   String?
  created_at   DateTime @default(now())

  laboratory laboratories? @relation(fields: [laboratory_id], references: [id])
  user       users?   @relation("AuditLogUser", fields: [user_id], references: [id])

  @@index([laboratory_id])
  @@index([user_id])
  @@index([entity])
  @@index([entity_id])
  @@index([created_at])
}

model devices {
  id            String   @id @default(uuid()) 
  laboratory_id String?  
  user_id       String?  
  device_id     String   @unique
  name          String?
  platform      String?
  app_version   String?
  last_active_at DateTime?
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories? @relation(fields: [laboratory_id], references: [id])
  user       users?   @relation("SessionUser", fields: [user_id], references: [id])
  sessions   sessions[] @relation("SessionDevice")


  @@index([laboratory_id])
  @@index([user_id])
  @@index([is_revoked])
}

model sessions {
  id            String   @id @default(uuid()) 
  user_id       String   
  laboratory_id String   
  device_id     String?  
  refresh_token String   @unique
  expires_at    DateTime
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user     users     @relation("SessionUser", fields: [user_id], references: [id], onDelete: Cascade)
  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  device   devices?   @relation("SessionDevice", fields: [device_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([refresh_token])
  @@index([laboratory_id])
  @@index([expires_at])
  @@index([is_revoked])
}

model sync_events {
  id            String   @id @default(uuid()) 
  laboratory_id String   
  aggregate_type String
  aggregate_id  String   
  event_type    String
  payload       Json
  status        String   @default("pending")
  retry_count   Int      @default(0)
  processed_at  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)

  @@index([laboratory_id])
  @@index([aggregate_type])
  @@index([aggregate_id])
  @@index([status])
  @@index([created_at])

}

model idempotency_keys {
  id           String   @id @default(uuid()) 
  key          String   @unique
  laboratory_id String  
  user_id      String?  
  operation    String
  response     Json?
  created_at   DateTime @default(now())
  expires_at   DateTime

  laboratory laboratories @relation(fields: [laboratory_id], references: [id], onDelete: Cascade)
  user       users?   @relation("IdempotencyKeyUser", fields: [user_id], references: [id])


  @@index([laboratory_id])
  @@index([user_id])
  @@index([expires_at])
}

model matricule_counters {
  id           String  @id @default(uuid()) 
  laboratory_id String 
  entity_type  String
  year         Int
  last_number  Int     @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  laboratory laboratories @relation("MatriculeCounterLab", fields: [laboratory_id], references: [id], onDelete: Cascade)

  @@unique([laboratory_id, entity_type, year])
  @@index([laboratory_id])
  @@index([entity_type])
  @@index([year])
}
