DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT="3000"
NODE_ENV="development"
REDIS_URL="redis://:password@host:6379"

# Public profile QR/signing (recommended in production)
PUBLIC_PROFILE_SECRET="change-me-public-profile-secret"

# SMTP (TurboSMTP)
SMTP_HOST="pro.turbo-smtp.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-turbosmtp-user"
SMTP_PASS="your-turbosmtp-password"
SMTP_FROM="Alliya Laboratoire <no-reply@alliya-labo.app>"
